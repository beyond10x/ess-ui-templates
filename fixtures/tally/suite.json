  "scenarios": {
    "tally.board.BumpCounter/outcome/bumped": {
      "purpose": "`tally.board.BumpCounter` answers `bumped` for an input no other branch's guard claims",
      "steps": [
        {
          "step": "execute_command",
          "command": "tally.board.CreateCounter",
          "actor": "tally.board.Member",
          "input": {
            "label": {
              "kind": "literal",
              "value": "Coffee"
            },
            "team": {
              "kind": "literal",
              "value": "Red"
            }
          }
        },
        {
          "step": "expect_outcome",
          "outcome": {
            "command": "tally.board.CreateCounter",
            "outcome": "created"
          }
        },
        {
          "step": "capture_instance",
          "instance": "counter",
          "entity": "tally.board.Counter",
          "event": "tally.board.CounterCreated",
          "field": "counter_id"
        },
        {
          "step": "execute_command",
          "command": "tally.board.BumpCounter",
          "actor": "tally.board.Member",
          "input": {
            "counter_id": {
              "kind": "instance",
              "instance": "counter"
            }
          }
        },
        {
          "step": "expect_outcome",
          "outcome": {
            "command": "tally.board.BumpCounter",
            "outcome": "bumped"
          }
        },
        {
          "step": "expect_event",
          "event": "tally.board.CounterBumped",
          "shape": {
            "counter_id": {
              "holds": "primitive",
              "kind": "uuid"
            }
          }
        },
        {
          "step": "expect_no_event",
          "event": "tally.board.CounterCreated"
        },
        {
          "step": "expect_no_event",
          "event": "tally.board.NotePinned"
        },
        {
          "step": "execute_command",
          "command": "tally.board.CreateCounter",
          "actor": "tally.board.Member",
          "input": {
            "label": {
              "kind": "literal",
              "value": "label-1"
            },
            "team": {
              "kind": "literal",
              "value": "team-1"
            }
          }
        },
        {
          "step": "expect_outcome",
          "outcome": {
            "command": "tally.board.CreateCounter",
            "outcome": "created"
          }
        },
        {
          "step": "capture_instance",
          "instance": "counter-2",
          "entity": "tally.board.Counter",
          "event": "tally.board.CounterCreated",
          "field": "counter_id"
        },
        {
          "step": "query_view",
          "view": "tally.board.Counters"
        },
        {
          "step": "expect_view",
          "view": "tally.board.Counters",
          "expectation": {
            "expect": "contains",
            "fields": {
              "counter_id": {
                "kind": "instance",
                "instance": "counter"
              },
              "hits": {
                "kind": "literal",
                "value": 1.0
              },
              "label": {
                "kind": "literal",
                "value": "Coffee"
              }
            }
          }
        },
        {
          "step": "expect_view",
          "view": "tally.board.Counters",
          "expectation": {
            "expect": "counts",
            "at_least": 2
          }
        },
        {
          "step": "expect_view",
          "view": "tally.board.Counters",
          "expectation": {
            "expect": "ranked",
            "order_by": [
              "hits desc"
            ]
          }
        }
      ],
      "source": [
        {
          "kind": "entity",
          "name": "tally.board.Counter"
        },
        {
          "kind": "command",
          "name": "tally.board.BumpCounter"
        },
        {
          "kind": "command",
          "name": "tally.board.CreateCounter"
        },
        {
          "kind": "outcome",
          "name": {
            "command": "tally.board.BumpCounter",
            "outcome": "bumped"
          }
        },
        {
          "kind": "outcome",
          "name": {
            "command": "tally.board.CreateCounter",
            "outcome": "created"
          }
        },
        {
          "kind": "event",
          "name": "tally.board.CounterBumped"
        },
        {
          "kind": "event",
          "name": "tally.board.CounterCreated"
        },
        {
          "kind": "event",
          "name": "tally.board.NotePinned"
        },
        {
          "kind": "view",
          "name": "tally.board.Counters"
        },
        {
          "kind": "actor",
          "name": "tally.board.Member"
        }
      ]
    },
