      "purpose": "Two counters of one team are bumped; the team's total is their sum, and the busier counter ranks first.",
      "steps": [
        {
          "step": "execute_command",
          "command": "tally.board.CreateCounter",
          "actor": "tally.board.Member",
          "input": {
            "label": {
              "kind": "literal",
              "value": "Coffee"
            },
            "team": {
              "kind": "literal",
              "value": "Red"
            }
          }
        },
        {
          "step": "expect_outcome",
          "outcome": {
            "command": "tally.board.CreateCounter",
            "outcome": "created"
          }
        },
        {
          "step": "capture_instance",
          "instance": "coffee",
          "entity": "tally.board.Counter",
          "event": "tally.board.CounterCreated",
          "field": "counter_id"
        },
        {
